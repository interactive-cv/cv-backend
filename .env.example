# ---- Database ----
POSTGRES_USER=cv
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cv
DATABASE_URL=postgresql+psycopg://cv:changeme@postgres:5432/cv

# ---- FastAPI ----
# PROD: обязательно сгенерировать СИЛЬНЫЕ значения (openssl rand -hex 32), не changeme!
ADMIN_TOKEN=change-this-to-a-long-random-string
SECRET_KEY=change-this-to-a-long-random-string
IP_HASH_SECRET=change-this-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://cv.example.com
CONTACTS_FALLBACK=you@example.com · Telegram @your_handle
# Публичный домен сайта — от него строятся короткие ссылки в admin-API.
SITE_URL=https://cv.example.com

# ---- z.ai ----
# ВАЖНО: подписка GLM Coding Plan работает ТОЛЬКО через coding-эндпоинт
# (https://api.z.ai/api/coding/paas/v4), НЕ через стандартный /api/paas/v4.
# Поддерживаемые модели: glm-5.2 (рекоменд., 1× квоты), glm-5-turbo, glm-4.7 (1× квоты).
ZAI_API_KEY=your-zai-key-here
ZAI_API_BASE=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.2

# ---- Rate limit ----
CHAT_RATE_PER_HOUR=50
CHAT_RATE_PER_DAY=300

# ---- Uploads ----
# Макс. размер загружаемого артефакта (APK, видео) в MB.
ARTIFACT_MAX_SIZE_MB=100

# ---- Let's Encrypt (TLS) ----
# Домен(ы) через запятую для сертификата и email для регистрации.
LE_EMAIL=your@email.com
LE_FQDN=your-domain.com
